# Backend secrets: set with `supabase secrets set`, never in browser files.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_WEBHOOK_VERIFY_TOKEN=
APP_BASE_URL=

# Admin panel (Edge Function secrets, server side only)
RESEND_API_KEY=      # optional: only for "Send Email" in the admin panel
MAIL_FROM=           # optional: e.g. "Try AI GPT <support@yourdomain.com>"

# Easebuzz (Edge Function secrets, server side only)
EASEBUZZ_KEY=
EASEBUZZ_SALT=
EASEBUZZ_ENV=test   # use "prod" when you go live
